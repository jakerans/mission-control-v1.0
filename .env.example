# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (local install, runs as a Windows service)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mission_control

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# Agents (Claude Agent SDK)
# API key from https://platform.claude.com — the sign-in method the Agent SDK docs say to use
ANTHROPIC_API_KEY=
# api_key (default) or claude_login (use this PC's Claude Code login / your Claude plan instead;
# only after confirming with Anthropic that it's allowed for your use)
AGENT_AUTH=api_key
# How many agents may work at once, and pause new work when the 5-hour plan window is this full (%)
AGENT_MAX_CONCURRENT=3
AGENT_PAUSE_AT_PERCENT=90
# Email on the agents' commits (e.g. your GitHub no-reply address)
AGENT_GIT_EMAIL=
